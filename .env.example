# Copie para .env (ou cole no formulário de Environment variables do Portainer).
# NUNCA comite o .env preenchido.

# --- Obrigatórios ---
DOMAIN=chat.suaempresa.com.br
ACME_EMAIL=ti@suaempresa.com.br
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- E-mail (obrigatório para convite de agentes e reset de senha) ---
MAILER_SENDER_EMAIL=Suporte <suporte@suaempresa.com.br>
SMTP_ADDRESS=smtp.suaempresa.com.br
SMTP_PORT=587
SMTP_DOMAIN=suaempresa.com.br
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# --- Opcionais ---
CHATWOOT_TAG=v4.18.0-ce
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false
RAILS_MAX_THREADS=5
